{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "title": "Total API Requests",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(api_requests_total)", "refId": "A" }
      ]
    },
    {
      "title": "Requests by Status",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 10, "x": 6, "y": 0 },
      "targets": [
        { "expr": "rate(api_requests_total[5m])", "legendFormat": "{{endpoint}} - {{status}}", "refId": "A" }
      ]
    },
    {
      "title": "Predictions Distribution",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "predictions_total", "legendFormat": "{{prediction}}", "refId": "A" }
      ]
    },
    {
      "title": "Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(api_request_duration_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(api_request_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "Request Rate (per second)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "sum(rate(api_requests_total[1m]))", "legendFormat": "req/s", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["mlops", "heart-disease"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Heart Disease API - Monitoring Dashboard",
  "uid": "heart-disease-dashboard"
}
